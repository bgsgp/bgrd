<Window x:Class="bgrd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:bgrd.Converters"
        Title="丐点名将·队列" Height="650" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="🎯 丐点名将·队列" FontSize="28" FontWeight="Bold" 
                       Foreground="{DynamicResource AccentBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="➕" Command="{Binding AddGroupCommand}" 
                        Background="Transparent" BorderThickness="0" FontSize="24" Cursor="Hand"
                        ToolTip="添加新队列"/>
                <Button Content="🔄" Command="{Binding RefreshGroupCommand}" 
                        Background="Transparent" BorderThickness="0" FontSize="22" Cursor="Hand"
                        ToolTip="刷新当前队列名单"/>
                <Button Content="⚙️" Command="{Binding OpenSettingsCommand}" 
                        Background="Transparent" BorderThickness="0" FontSize="24" Cursor="Hand"
                        ToolTip="设置"/>
                <Button Content="🌓" Command="{Binding ToggleThemeCommand}" 
                        Background="Transparent" BorderThickness="0" FontSize="24" Cursor="Hand"
                        ToolTip="切换主题"/>
            </StackPanel>
        </Grid>

        <!-- 主区域 -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 队列列表 -->
            <Border Background="{DynamicResource SecondaryBrush}" CornerRadius="8" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="8">
                <ListBox ItemsSource="{Binding Groups}" 
                         SelectedItem="{Binding SelectedGroup}"
                         Background="Transparent" BorderThickness="0"
                         FontSize="16">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <Button Grid.Column="1" Content="✖" 
                                        Command="{Binding DataContext.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" 
                                        Background="Transparent" BorderThickness="0" 
                                        Foreground="Red" Cursor="Hand" FontSize="14"
                                        ToolTip="删除此队列"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 结果展示 -->
            <Border Grid.Column="1" Margin="10,0,0,0" 
                    Background="{DynamicResource SecondaryBrush}" CornerRadius="8" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding ResultText}" FontSize="48" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" 
                                HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="抽取人数:" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding PickCount, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="60" Height="30" TextAlignment="Center" FontSize="16"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,10,0"/>
                        <Button Content="🚀 开始" Command="{Binding StartPickCommand}" 
                                IsEnabled="{Binding IsPicking, Converter={StaticResource InverseBooleanConverter}}"
                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                FontSize="16" FontWeight="Bold" Padding="15,8" 
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态 -->
        <StatusBar Grid.Row="2" Background="Transparent" Height="30">
            <StatusBarItem>
                <TextBlock Foreground="{DynamicResource TextBrush}">
                    <Run Text="当前队列人数: "/>
                    <Run Text="{Binding SelectedGroup.Names.Count, Mode=OneWay, FallbackValue=0}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>