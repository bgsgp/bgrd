<Window x:Class="bgrd.Views.GroupEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加/编辑队列" Height="187" Width="503"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="35.24"/>
            <RowDefinition Height="Auto" MinHeight="27"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="39"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto" MinWidth="5"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="队列名称:" VerticalAlignment="Center" 
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" Height="16"/>
        <TextBox Grid.Row="0" Grid.Column="1" 
                 Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="名单文件:" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" Height="16"/>
        <TextBox Grid.Column="1" Text="{Binding FilePath}" 
                 IsReadOnly="True" Margin="0,35,5,0" Grid.RowSpan="2"/>
        <Button Grid.Column="1" Content="浏览..." Click="Browse_Click" 
                Padding="10,5" Cursor="Hand" Margin="288,35,0,0" Grid.RowSpan="2"/>

        <StackPanel Grid.Row="3" Grid.Column="1" 
                    Orientation="Horizontal" HorizontalAlignment="Left" Margin="218,5,0,1" Width="165">
            <Button Content="确定" Click="Ok_Click" IsDefault="True" 
                    Padding="15,8" Margin="0,0,10,0" 
                    Background="{DynamicResource AccentBrush}" Foreground="White" Width="75"/>
            <Button Content="取消" Click="Cancel_Click" IsCancel="True" 
                    Padding="15,8" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                    Foreground="{DynamicResource TextBrush}" Width="75"/>
        </StackPanel>
    </Grid>
</Window>